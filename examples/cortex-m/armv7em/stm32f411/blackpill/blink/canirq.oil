OIL_VERSION = "2.5";

IMPLEMENTATION trampoline {
    TASK { UINT32 STACKSIZE = 300 ; } ;
    ISR  { UINT32 STACKSIZE = 200 ; } ;
};

CPU canirq {
  OS config {
    STATUS = EXTENDED;
    PRETASKHOOK = FALSE;
    POSTTASKHOOK = FALSE;
    PAINT_STACK = TRUE;
    PAINT_REGISTERS = TRUE;

    BUILD = TRUE {
      TRAMPOLINE_BASE_PATH = "../../../../../..";
      APP_SRC = "canirq.c";
      APP_NAME = "canirq_exe";
      CFLAGS  = "-O0";
      LDFLAGS = "-Map=canirq.map";
      COMPILER = "arm-none-eabi-gcc";
      ASSEMBLER = "arm-none-eabi-as";
      LINKER = "arm-none-eabi-ld";
      COPIER = "arm-none-eabi-objcopy";
      SYSTEM = PYTHON;
    };
    SYSTEM_CALL = TRUE;
    MEMMAP = TRUE {
      COMPILER = gcc;
      LINKER = gnu_ld { SCRIPT = "script.ld"; };
      ASSEMBLER = gnu_as;
      MEMORY_PROTECTION = FALSE;
    };
  };

  APPMODE std {};

  EVENT EV_CAN_RX { MASK = AUTO; };

  TASK Task_CAN_RX {
    PRIORITY = 6; AUTOSTART = TRUE { APPMODE = std; };
    ACTIVATION = 1; SCHEDULE = FULL;
    EVENT = EV_CAN_RX;
  };
  TASK heartbeat { PRIORITY = 1; AUTOSTART = FALSE; ACTIVATION = 1; SCHEDULE = FULL; };

  ISR ISR_CAN {
    CATEGORY = 2;
    PRIORITY = 1;
    SOURCE = EXTI1_IRQ;
  };

  ALARM al_hb { COUNTER = SystemCounter; ACTION = ACTIVATETASK { TASK = heartbeat; };
                AUTOSTART = TRUE { APPMODE = std; ALARMTIME = 250; CYCLETIME = 250; }; };
};