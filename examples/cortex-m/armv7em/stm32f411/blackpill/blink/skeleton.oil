OIL_VERSION = "2.5";

IMPLEMENTATION trampoline {
    TASK { UINT32 STACKSIZE = 300 ; } ;
    ISR  { UINT32 STACKSIZE = 200 ; } ;
};

CPU skeleton {
  OS config {
    STATUS = EXTENDED;
    PRETASKHOOK = FALSE;
    POSTTASKHOOK = FALSE;
    PAINT_STACK = TRUE;
    PAINT_REGISTERS = TRUE;

    BUILD = TRUE {
      TRAMPOLINE_BASE_PATH = "../../../../../..";
      APP_SRC = "skeleton.c";
      APP_NAME = "skeleton_exe";
      CFLAGS  = "-O0";
      LDFLAGS = "-Map=skeleton.map";
      COMPILER = "arm-none-eabi-gcc";
      ASSEMBLER = "arm-none-eabi-as";
      LINKER = "arm-none-eabi-ld";
      COPIER = "arm-none-eabi-objcopy";
      SYSTEM = PYTHON;
    };
    SYSTEM_CALL = TRUE;
    MEMMAP = TRUE {
      COMPILER = gcc;
      LINKER = gnu_ld { SCRIPT = "script.ld"; };
      ASSEMBLER = gnu_as;
      MEMORY_PROTECTION = FALSE;
    };
  };

  APPMODE std {};

  TASK Acquisition { PRIORITY = 5; AUTOSTART = FALSE; ACTIVATION = 1; SCHEDULE = FULL; };
  TASK Processing  { PRIORITY = 4; AUTOSTART = FALSE; ACTIVATION = 1; SCHEDULE = FULL; };
  TASK Display     { PRIORITY = 3; AUTOSTART = FALSE; ACTIVATION = 1; SCHEDULE = FULL; };
  TASK Diagnostics { PRIORITY = 2; AUTOSTART = FALSE; ACTIVATION = 1; SCHEDULE = FULL; };
  TASK Logging     { PRIORITY = 1; AUTOSTART = FALSE; ACTIVATION = 1; SCHEDULE = FULL; };
  TASK heartbeat   { PRIORITY = 1; AUTOSTART = FALSE; ACTIVATION = 1; SCHEDULE = FULL; };

  ALARM al_acq  { COUNTER = SystemCounter; ACTION = ACTIVATETASK { TASK = Acquisition; };
                  AUTOSTART = TRUE { APPMODE = std; ALARMTIME = 1;   CYCLETIME = 10;   }; };
  ALARM al_proc { COUNTER = SystemCounter; ACTION = ACTIVATETASK { TASK = Processing; };
                  AUTOSTART = TRUE { APPMODE = std; ALARMTIME = 1;   CYCLETIME = 20;   }; };
  ALARM al_disp { COUNTER = SystemCounter; ACTION = ACTIVATETASK { TASK = Display; };
                  AUTOSTART = TRUE { APPMODE = std; ALARMTIME = 1;   CYCLETIME = 50;   }; };
  ALARM al_diag { COUNTER = SystemCounter; ACTION = ACTIVATETASK { TASK = Diagnostics; };
                  AUTOSTART = TRUE { APPMODE = std; ALARMTIME = 1;  CYCLETIME = 100;  }; };
  ALARM al_log  { COUNTER = SystemCounter; ACTION = ACTIVATETASK { TASK = Logging; };
                  AUTOSTART = TRUE { APPMODE = std; ALARMTIME = 1; CYCLETIME = 1000; }; };
  ALARM al_hb   { COUNTER = SystemCounter; ACTION = ACTIVATETASK { TASK = heartbeat; };
                  AUTOSTART = TRUE { APPMODE = std; ALARMTIME = 1;  CYCLETIME = 250;  }; };
};