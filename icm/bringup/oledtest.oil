OIL_VERSION = "2.5";

IMPLEMENTATION trampoline {
    TASK { UINT32 STACKSIZE = 300 ; } ;
    ISR  { UINT32 STACKSIZE = 200 ; } ;
};

CPU oledtest {
  OS config {
    STATUS = EXTENDED;
    PRETASKHOOK = FALSE;
    POSTTASKHOOK = FALSE;
    PAINT_STACK = TRUE;
    PAINT_REGISTERS = TRUE;

    BUILD = TRUE {
      TRAMPOLINE_BASE_PATH = "../..";
      APP_SRC = "oledtest.c";
      APP_NAME = "oledtest_exe";
      CFLAGS  = "-O0";
      LDFLAGS = "-Map=oledtest.map";
      COMPILER = "arm-none-eabi-gcc";
      ASSEMBLER = "arm-none-eabi-as";
      LINKER = "arm-none-eabi-ld";
      COPIER = "arm-none-eabi-objcopy";
      SYSTEM = PYTHON;
    };
    SYSTEM_CALL = TRUE;
    MEMMAP = TRUE {
      COMPILER = gcc;
      LINKER = gnu_ld { SCRIPT = "script.ld"; };
      ASSEMBLER = gnu_as;
      MEMORY_PROTECTION = FALSE;
    };
  };

  APPMODE std {};

  TASK oledprobe { PRIORITY = 1; AUTOSTART = FALSE; ACTIVATION = 1; SCHEDULE = FULL; };
  TASK heartbeat { PRIORITY = 1; AUTOSTART = FALSE; ACTIVATION = 1; SCHEDULE = FULL; };

  ALARM al_oledprobe {
    COUNTER = SystemCounter;
    ACTION = ACTIVATETASK { TASK = oledprobe; };
    AUTOSTART = TRUE { APPMODE = std; ALARMTIME = 500; CYCLETIME = 500; };
  };

  ALARM al_heartbeat {
    COUNTER = SystemCounter;
    ACTION = ACTIVATETASK { TASK = heartbeat; };
    AUTOSTART = TRUE { APPMODE = std; ALARMTIME = 250; CYCLETIME = 250; };
  };
};